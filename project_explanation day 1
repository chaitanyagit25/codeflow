import { StrictMode } from "react";
import { createRoot } from "react-dom/client";
import "./index.css";           // Load global styles
import App from "./App.jsx";    // Load root component

createRoot(document.getElementById("root")).render(
  <StrictMode>
    <App />
  </StrictMode>
);
```

**Line by line:**
1. `createRoot(document.getElementById("root"))` — Finds the `<div id="root">` in `index.html` and creates a React root
2. `.render(...)` — Renders the `<App />` component into that div
3. `<StrictMode>` — A React development tool that:
   - Runs components twice to detect side effects
   - Warns about deprecated APIs
   - Has **no effect in production**
4. `import "./index.css"` — Loads the global stylesheet (Tailwind + custom animations)

